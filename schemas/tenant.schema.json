{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rulehealth.local/schemas/tenant.schema.json",
  "title": "Tenant connection settings (written by the setup wizard, POST /api/tenants)",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "alias": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "tenantId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
      "description": "Entra tenant id (GUID)"
    },
    "displayName": {
      "type": "string"
    },
    "workspaces": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "subscriptionId": {
            "type": "string"
          },
          "resourceGroup": {
            "type": "string"
          },
          "workspaceName": {
            "type": "string"
          },
          "workspaceId": {
            "type": "string",
            "description": "Log Analytics workspace (customer) ID, a GUID"
          }
        },
        "required": [
          "subscriptionId",
          "resourceGroup",
          "workspaceName",
          "workspaceId"
        ],
        "additionalProperties": false
      }
    },
    "auth": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "pkce",
            "microsoft-apps",
            "offline",
            "browser",
            "cli",
            "cli-graph"
          ],
          "description": "pkce = browser sign-in with the user's own app registration (recommended). microsoft-apps = browser sign-in through Microsoft's public apps (Microsoft Graph Command Line Tools for Graph, Microsoft Azure PowerShell for ARM and Log Analytics), no clientId. offline = demo/markdown data. browser, cli and cli-graph are pre-M8 values: browser with a clientId signs in as pkce, the others must be connected again."
        },
        "clientId": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "description": "Application (client) id of the user's own single-tenant app registration. Not a secret."
        }
      },
      "required": [
        "mode"
      ],
      "additionalProperties": false,
      "if": {
        "properties": {
          "mode": {
            "const": "pkce"
          }
        }
      },
      "then": {
        "required": [
          "mode",
          "clientId"
        ]
      }
    },
    "defaults": {
      "type": "object",
      "properties": {
        "incidentDays": {
          "type": "integer",
          "default": 90
        },
        "validationDays": {
          "type": "integer",
          "default": 30,
          "maximum": 30,
          "description": "Advanced hunting caps lookback at 30 days"
        }
      },
      "additionalProperties": false
    },
    "demo": {
      "type": "boolean",
      "description": "True when the content is synthetic sample data, never set by the engine"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schemaVersion",
    "alias",
    "auth"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "auth": {
            "properties": {
              "mode": {
                "enum": [
                  "pkce",
                  "microsoft-apps"
                ]
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "tenantId"
        ]
      }
    }
  ]
}